  font-size: 16px;
  opacity: 0.6;
  cursor: pointer;
  transition: 0.3s;
  padding: 4px 8px;
  border-radius: 4px;
}
.btn-silent:hover {
  opacity: 1;
  background-color: rgba(255,255,255,0.1);
