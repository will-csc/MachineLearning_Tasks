  --card: #FFFFFF;
  --accent: #3F72AF;
  --muted: #6B7A90;
  --success: #2E8B57;
  --danger: #E74C3C;
}

/* ===== BASE ===== */
body {
  margin: 0;
  font-family: "Open Sans", Arial, sans-serif;
  background: var(--bg);
  color: #112D4E;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

h1, h2, h3, h4, h5 {
  margin: 0;
}

/* ===== TOPO ===== */
.topbar {
  background-color: var(--accent);
  color: white;
  padding: 10px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 3px 8px rgba(17,45,78,0.12);
}

.brand {
  font-size: 22px;
  font-weight: 700;
  margin: 0;
}

/* Botão discreto de modo silêncio */
.btn-silent {
  background: none;
